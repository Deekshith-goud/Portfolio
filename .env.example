# ─── Sanity CMS (REQUIRED) ────────────────────────────────────────────────────
# Your Sanity project ID — already set from `npm create sanity@latest`
NEXT_PUBLIC_SANITY_PROJECT_ID="your-project-id"

# Dataset name (production / staging etc.)
NEXT_PUBLIC_SANITY_DATASET="production"

# API version — keep as is or update to today's date (YYYY-MM-DD)
NEXT_PUBLIC_SANITY_API_VERSION="2023-07-21"

# Access token (OPTIONAL — comment out if you don't have one yet)
# Create one at: https://www.sanity.io/manage/project/your-project-id/api → Tokens → Add API token
# Set permission to "Editor", copy the token and paste it below, then uncomment.
# NEXT_PUBLIC_SANITY_ACCESS_TOKEN=

# Webhook secret (OPTIONAL — only needed for on-demand ISR / revalidation)
# SANITY_HOOK_SECRET=

# Write token (OPTIONAL — only needed for visitor view count)
# SANITY_API_WRITE_TOKEN=

# ─── Umami Analytics (OPTIONAL) ───────────────────────────────────────────────
# Get from: https://umami.is → your site → Settings → Website ID
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# ─── Giscus Comments (OPTIONAL) ───────────────────────────────────────────────
# Set up at: https://giscus.app — connect your GitHub repo to generate these IDs
# NEXT_PUBLIC_GISCUS_REPO=          # e.g. "YourUsername/your-repo"
# NEXT_PUBLIC_GISCUS_REPOID=        # e.g. "R_kgDO..."
# NEXT_PUBLIC_GISCUS_CATEGORYID=    # e.g. "DIC_kwDO..."

# ─── GitHub Activity Graph (OPTIONAL) ─────────────────────────────────────────
# Your GitHub username and the year you joined# GitHub credentials
NEXT_PUBLIC_GITHUB_USERNAME="your-github-username"
GITHUB_TOKEN=
NEXT_PUBLIC_GITHUB_JOIN_YEAR="2024"

# ─── Upstash Redis Rate Limiting ──────────────────────────────────────────
# Create a free Redis database at https://upstash.com
# Used for abuse protection on the visitor tracking API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
